# Copy to .env. Everything is optional: with no key and no Ollama the agent
# still runs end-to-end using the deterministic template drafter (labelled
# "template" in the UI and in EVALS.md) so the console never goes blank.

# --- Model backend -----------------------------------------------------------
# auto (default): ollama if reachable, else openrouter if a key is set, else template.
AGRITWIN_MODEL_PROVIDER=auto

# Local open-weights via Ollama (the on-prem path: plot/household data never leaves the office).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b          # qwen3:4b is fine on a CPU-only laptop

# Hosted open-weights via OpenRouter (free tier works). Gemma 4 and Nemotron 3 are open-weights.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional frontier comparison (only used by `agritwin-evals --provider anthropic`).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Data -------------------------------------------------------------------
AGRITWIN_DB=data/agritwin.db
AGRITWIN_AUDIT_JSONL=data/audit.jsonl
# The demo fixture is dated 2026-09-27; weather ingestion uses this as "today".
AGRITWIN_TODAY=2026-09-27
# Set to 0 to skip live Open-Meteo calls (the seeded rainfall cache is used instead).
AGRITWIN_LIVE_WEATHER=1

# --- Server -----------------------------------------------------------------
AGRITWIN_HOST=127.0.0.1
AGRITWIN_PORT=8000
